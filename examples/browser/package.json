{
  "name": "llpage-browser",
  "version": "1.0.0",
  "description": "Modern browser based on Electron and llpage",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --debug-panel",
    "build": "electron-builder"
  },
  "keywords": [
    "llpage",
    "electron",
    "browser"
  ],
  "author": "llpage team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-reload": "^1.5.0"
  },
  "dependencies": {
    "llpage": "file:../..",
    "electron-store": "^8.1.0",
    "vue": "^3.3.4",
    "tailwindcss": "^3.3.5",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21"
  },
  "build": {
    "appId": "com.llpage.browser",
    "productName": "LLPage Browser",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "directories": {
      "output": "dist"
    }
  }
}
